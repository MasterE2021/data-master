{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "data-master",
  "version": "0.1.0",
  "identifier": "com.mastere.data-master",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "data-master",
        "width": 900,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default permissions for the app",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "core:window:default",
            "dialog:default",
            "shell:default",
            "fs:default",
            {
              "identifier": "fs:allow-read-dir",
              "allow": [
                {
                  "path": "**"
                }
              ]
            },
            {
              "identifier": "fs:allow-exists",
              "allow": [
                {
                  "path": "**"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}